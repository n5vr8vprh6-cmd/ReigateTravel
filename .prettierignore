# Vendored agent-skill installs and their lockfile. Third-party source, not this
# project's code — formatting it would rewrite files we do not own, and it is what
# made `npm run verify` fail at format:check. `.claude/rules` is deliberately NOT
# ignored: those are project-authored and should stay formatted.
.agents
.claude/skills
skills-lock.json

# Agent worktrees. These are transient checkouts of this same repo under `.claude/worktrees/`;
# git already excludes them as registered worktrees, but Prettier walks them and then fails
# format:check on files that belong to another branch. The `.claude/skills` rule above does not
# cover them - it is anchored at the root, and a worktree nests its own copy one level down.
.claude/worktrees
