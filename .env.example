# Reigate Travel & Co. — environment variables (example)
# Copy to .env.local for local development. Never commit real secrets.

# Set to "true" ONLY on the approved production deployment to allow search indexing.
# Any other value (or unset) keeps the site noindex — protects preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public site origin. Defaults to the approved production domain.
NEXT_PUBLIC_SITE_URL=https://www.reigatetravel.co

# --- Guided inquiry delivery (Resend) ---
# Resend is the approved provider. The standing rule still holds: a submission is never
# simulated. With these unset the form does not render at all and /begin-planning falls back
# to the approved mailto path, rather than showing a submit button it cannot honour.
#
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_ - that ships the value to the
# browser. Put real values in .env.local (git-ignored) AND in Vercel > Settings > Environment
# Variables, marked Sensitive. Never commit them.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend. Use a subdomain rather than the root:
# only one SPF TXT record is permitted per name, so putting Resend's records on the root
# risks breaking inbound mail once a mailbox provider is added there.
# Format: "Reigate Travel & Co. <concierge@send.reigatetravel.co>"
INQUIRY_FROM_EMAIL=

# Where inquiries are delivered. Falls back to site.inquiryEmail when unset.
INQUIRY_TO_EMAIL=
