# Reigate Travel & Co. — environment variables (example)
# Copy to .env.local for local development. Never commit real secrets.

# Set to "true" ONLY on the approved production deployment to allow search indexing.
# Any other value (or unset) keeps the site noindex — protects preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public site origin. Defaults to the approved production domain.
NEXT_PUBLIC_SITE_URL=https://www.reigatetravel.co

# --- Not used in Milestone 1 (guided inquiry form is a later milestone) ---
# No email-delivery provider has been approved yet. Do not add credentials here
# or simulate inquiry submission until a provider is approved.
# INQUIRY_EMAIL_PROVIDER=
# INQUIRY_EMAIL_API_KEY=
