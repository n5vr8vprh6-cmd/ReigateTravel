# Reigate Travel & Co. — environment variables (example)
# Copy to .env.local for local development. Never commit real secrets.

# Set to "true" ONLY on the approved production deployment to allow search indexing.
# Any other value (or unset) keeps the site noindex — protects preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public site origin. Defaults to the approved production domain.
NEXT_PUBLIC_SITE_URL=https://www.reigatetravel.co

# --- Guided inquiry delivery (Resend) ---
# Resend is the approved provider. The standing rule still holds: a submission is never
# simulated. With these unset the form does not render at all and /begin-planning falls back
# to the approved mailto path, rather than showing a submit button it cannot honour.
#
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_ - that ships the value to the
# browser. Put real values in .env.local (git-ignored) AND in Vercel > Settings > Environment
# Variables, marked Sensitive. Never commit them.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend. Use a subdomain rather than the root:
# only one SPF TXT record is permitted per name, so putting Resend's records on the root
# risks breaking inbound mail once a mailbox provider is added there.
# Format: "Reigate Travel & Co. <concierge@send.reigatetravel.co>"
INQUIRY_FROM_EMAIL=

# Where inquiries are delivered. Falls back to site.inquiryEmail when unset.
INQUIRY_TO_EMAIL=

# --- Measurement (Vercel Web Analytics) ---
# "true" ONLY where Web Analytics is actually enabled for the project in the Vercel dashboard.
# Unset or any other value means no script is loaded at all - which is the state this ships in.
# Case and surrounding whitespace do not matter: TRUE and True both work. That leniency is
# deliberate - the first time this was set for real it was stored as TRUE, a strict comparison
# rejected it, and the deployment measured nothing while looking entirely correct.
#
# The order matters. Enable Web Analytics in Vercel FIRST, then set this. Setting it while the
# product is off points a script tag at a route that 404s, which costs a failed request and a
# console error on every page and returns no data.
#
# It also drives the measurement paragraph on /privacy, so the page cannot describe tracking
# the deployment is not doing, or stay silent about tracking it is.
NEXT_PUBLIC_ANALYTICS=false

# --- Booking (Calendly) ---
# The Calendly event URL for a planning conversation, e.g.
# https://calendly.com/reigatetravel/planning-conversation
#
# Public by nature (it becomes an embed in the page), so NEXT_PUBLIC_ is correct here.
#
# Unset, or set to anything that is not an https://calendly.com/... URL, and the confirmation
# page renders its original "Tyler will reply within 24-48 hours" copy instead of a booking
# step. The host is checked deliberately: this value becomes a third-party iframe, so a typo
# or a bad paste fails closed rather than framing an arbitrary site.
#
# Charter 10 permits a scheduling link "only after the intended sales process is confirmed" -
# so leave this unset until the event, its duration and its questions are actually settled.
NEXT_PUBLIC_CALENDLY_URL=
