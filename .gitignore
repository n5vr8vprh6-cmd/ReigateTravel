# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache
/tests/screenshots

# misc
.DS_Store
*.pem
.vscode/
.idea/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*
# .env.example is documentation and is tracked; the blanket rule above would hide it.
!.env.example.local
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# agent-skill installs — vendored third-party source, restored from skills-lock.json
# rather than committed, the same way node_modules is restored from package-lock.json.
# skills-lock.json IS tracked: it pins the versions. `.claude/rules` is project-authored
# and stays tracked; only the installed skills under `.claude/skills` are ignored.
/.agents/
/.claude/skills/
.env*
